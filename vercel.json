{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/plants", "destination": "/api/plants.json" },
    { "source": "/api/alerts", "destination": "/api/alerts.json" },
    { "source": "/api/summary", "destination": "/api/summary.json" },
    { "source": "/api/rover/status", "destination": "/api/rover/status.json" },
    { "source": "/3d", "destination": "/agribot_3d_viewer.html" },
    { "source": "/viewer", "destination": "/agribot_3d_viewer.html" },
    { "source": "/drawings", "destination": "/agribot_print_drawings.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/cad/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
