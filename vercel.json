{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/viewer", "destination": "/index.html" },
    { "source": "/3d", "destination": "/index.html" },
    { "source": "/drawings", "destination": "/agribot_print_drawings.html" },
    { "source": "/visualizer/agribot_3d_viewer.html", "destination": "/index.html" },
    { "source": "/visualizer/agribot_print_drawings.html", "destination": "/agribot_print_drawings.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/cad/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
